# Base URL of the ReadMe API, with a trailing slash. One of:
#   http://api.readme.local:3000/
#   https://api.readmestaging.com/
#   https://api.readme.com/
API_ENDPOINT_DOMAIN=http://api.readme.local:3000/

# One API key per dummy project (Settings → API Keys). Leave a key blank to skip that profile.
# The suite changes live settings on these projects and restores them afterwards.

# Free plan, trial expired, no add-ons
NON_PAYING_PROJECT_API_KEY=

# Pro plan without the AI Booster Pack
PRO_NO_BOOSTER_PROJECT_API_KEY=

# Pro plan with the AI Booster Pack
PRO_WITH_BOOSTER_PROJECT_API_KEY=

# Enterprise group parent
ENTERPRISE_PARENT_PROJECT_API_KEY=

# A child project of the enterprise parent above
ENTERPRISE_CHILD_PROJECT_API_KEY=

# Set to true to fail before any write when a project does not match its profile (plan, booster, parent)
STRICT_PROFILES=false

# Set to true to also run tests that can lock or break the project (subdomain, custom domain, site privacy, TLS)
RUN_DESTRUCTIVE=false
